{
  "name": "madhouse-wiki",
  "version": "1.24.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker compose -f compose.dev.yml up -d --build --wait --wait-timeout 180",
    "dev:raids": "MADHOUSE_RAIDS_FIXTURE=1 docker compose -f compose.dev.yml up -d --build --wait --wait-timeout 180",
    "dev:connector": "docker compose -f compose.dev.yml up -d --build --wait --wait-timeout 180 connector",
    "build:connector": "vite build --config connector/vite.config.mjs",
    "build": "vite build",
    "build:hosted": "node scripts/catalogue/restore-seed.mjs && vite build",
    "start:raids-worker": "node --env-file-if-exists=.env.local scripts/telegram/raid-live-worker.mjs",
    "telegram:configure": "node scripts/telegram/configure-wiki-bot.mjs",
    "catalogue:package": "node scripts/catalogue/package-seed.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:data": "node scripts/validate-data.mjs",
    "test": "node --test --test-concurrency=2",
    "check": "npm run validate:data && npm run lint && npm run lint:ui && npm run format:check && npm test && npm run build",
    "build:vercel": "node scripts/deploy/build-vercel.mjs",
    "lint:ui": "node scripts/validate-ui-styles.mjs",
    "build:raids-worker": "node scripts/deploy/build-raid-worker.mjs",
    "dev:local": "vite",
    "docker:up": "docker compose -f compose.dev.yml up -d --build --wait --wait-timeout 180",
    "docker:down": "docker compose -f compose.dev.yml down",
    "docker:logs": "docker compose -f compose.dev.yml logs -f --tail=100",
    "docker:status": "docker compose -f compose.dev.yml ps",
    "docker:autostart": "node scripts/dev/install-autostart.mjs",
    "dev:connector:local": "vite --config connector/vite.config.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "esbuild": true,
    "puppeteer": true
  },
  "dependencies": {
    "@fuman/node": "0.0.22",
    "@mtcute/web": "0.32.5",
    "@tabler/icons-react": "^3.49.0",
    "qrcode": "1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "puppeteer": "^25.12.0",
    "sharp": "^0.35.5",
    "vite": "^6.3.5"
  }
}
