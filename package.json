{
  "name": "madhouse-wiki",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:connector": "vite --config connector/vite.config.mjs",
    "build:connector": "vite build --config connector/vite.config.mjs",
    "build": "vite build",
    "build:hosted": "node scripts/catalogue/restore-seed.mjs && vite build",
    "catalogue:package": "node scripts/catalogue/package-seed.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:data": "node scripts/validate-data.mjs",
    "test": "node --test",
    "check": "npm run validate:data && npm run lint && npm run format:check && npm test && npm run build",
    "build:vercel": "node scripts/deploy/build-vercel.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@mtcute/web": "0.32.5",
    "qrcode": "1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^6.3.5"
  }
}
