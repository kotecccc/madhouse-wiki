<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.madhouse-wiki.raid-live-worker</string>
    <key>ProgramArguments</key>
    <array>
      <string>/opt/homebrew/bin/node</string>
      <string>--env-file=/Users/mac/projects/madhouse-wiki/.env.local</string>
      <string>scripts/telegram/raid-live-worker.mjs</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/mac/projects/madhouse-wiki</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ExitTimeOut</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Users/mac/Library/Logs/MadhouseWiki/raid-live-worker.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mac/Library/Logs/MadhouseWiki/raid-live-worker.error.log</string>
  </dict>
</plist>
