[Unit]
Description=Clean expired Madhouse Wiki analytics from VPS storage
Requires=docker.service
After=docker.service madhouse-wiki-release.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker compose --project-name madhouse-wiki --file /opt/madhouse-wiki/vps-compose.yml --env-file /opt/madhouse-wiki/release.env exec --no-TTY wiki node scripts/deploy/run-analytics-cleanup.mjs
User=root
Group=root
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/docker
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
