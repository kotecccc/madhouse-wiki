# Copy to /opt/madhouse-wiki/wiki.env and set values from current production.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_WEBHOOK_SECRET=
WIKI_ADMIN_TELEGRAM_ID=
CRON_SECRET=

# Server-owned automation. Set to 0 only to explicitly disable the service.
MADHOUSE_AUTOMATION_GAME_ENABLED=1
MADHOUSE_AUTOMATION_STATE_DIR=/data/automation
