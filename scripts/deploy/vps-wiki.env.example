# Copy to /opt/madhouse-wiki/wiki.env and set values from current production.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_WEBHOOK_SECRET=
WIKI_ADMIN_TELEGRAM_ID=
CRON_SECRET=

# Server-owned automation. Set to 0 only to explicitly disable the service.
MADHOUSE_AUTOMATION_GAME_ENABLED=1
MADHOUSE_AUTOMATION_STATE_DIR=/data/automation

# Bridge route selection stays disabled until the P9/R0 gates and pilot approval.
MADHOUSE_BRIDGE_ROUTE_SELECTION_ENABLED=0
MADHOUSE_BRIDGE_R0_RELEASE_SHA=
# Operator attestation only after verifying every deployed legacy direct API is retired.
MADHOUSE_BRIDGE_LEGACY_EGRESS_REVIEWED=0
# Operator attestation only after the installed storage service supports encrypted game credentials.
MADHOUSE_BRIDGE_STORAGE_CREDENTIAL_PATH_VERIFIED=0

# Optional until the desktop auth-recovery readiness gate is approved.
# If configured, use one stable canonical base64url encoding of 32 random bytes.
# MADHOUSE_GAME_CREDENTIAL_KEY=
