FROM node:24-bookworm-slim

ENV NODE_ENV=development \
    PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates chromium fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --include=dev \
    && sha256sum package.json package-lock.json | sha256sum | cut -d ' ' -f 1 > node_modules/.madhouse-dev-deps
COPY scripts/dev/docker-entrypoint.sh /usr/local/bin/madhouse-dev
RUN chmod +x /usr/local/bin/madhouse-dev

EXPOSE 4174 4199
ENTRYPOINT ["/usr/local/bin/madhouse-dev"]
CMD ["npm", "run", "dev:local", "--", "--host", "0.0.0.0", "--port", "4174", "--strictPort"]
